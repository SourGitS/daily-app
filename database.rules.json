{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "sessions": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('restoreGeneration').val() === newData.parent().child('__dailyRestoredAt').val() && ((newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.parent().child('__dailyRestoredAt').val()) || (newData.child('deletedAt').isNumber() && newData.child('deletedAt').val() >= newData.parent().child('__dailyRestoredAt').val()))))" }
        },
        "weights": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('restoreGeneration').val() === newData.parent().child('__dailyRestoredAt').val() && ((newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.parent().child('__dailyRestoredAt').val()) || (newData.child('deletedAt').isNumber() && newData.child('deletedAt').val() >= newData.parent().child('__dailyRestoredAt').val()))))" }
        },
        "notes": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.parent().child('__dailyRestoredAt').val()) || (newData.child('deletedAt').isNumber() && newData.child('deletedAt').val() >= newData.parent().child('__dailyRestoredAt').val()))" }
        },
        "weeklyReviews": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.parent().child('__dailyRestoredAt').val()))" }
        },
        "budgetData": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.parent().child('__dailyRestoredAt').val()))" }
        },
        "savingsLog": {
          "$row": { ".validate": "$row === '__dailyRestoredAt' ? (newData.isNumber() && newData.val() > 0) : (!newData.parent().child('__dailyRestoredAt').exists() || (newData.child('t').isNumber() && newData.child('t').val() >= newData.parent().child('__dailyRestoredAt').val()))" }
        },
        "transactions": {
          "recordSync": { ".validate": "newData.val() === 1" }
        },
        "ledger": {
          "recordSync": { ".validate": "newData.val() === 1" }
        },
        ".write": "auth != null && auth.uid === $uid && (!data.child('sessions/__dailyRestoredAt').exists() || newData.child('sessions/__dailyRestoredAt').val() >= data.child('sessions/__dailyRestoredAt').val()) && (!data.child('weights/__dailyRestoredAt').exists() || newData.child('weights/__dailyRestoredAt').val() >= data.child('weights/__dailyRestoredAt').val()) && (!data.child('notes/__dailyRestoredAt').exists() || newData.child('notes/__dailyRestoredAt').val() >= data.child('notes/__dailyRestoredAt').val()) && (!data.child('weeklyReviews/__dailyRestoredAt').exists() || newData.child('weeklyReviews/__dailyRestoredAt').val() >= data.child('weeklyReviews/__dailyRestoredAt').val()) && (!data.child('budgetData/__dailyRestoredAt').exists() || newData.child('budgetData/__dailyRestoredAt').val() >= data.child('budgetData/__dailyRestoredAt').val()) && (!data.child('savingsLog/__dailyRestoredAt').exists() || newData.child('savingsLog/__dailyRestoredAt').val() >= data.child('savingsLog/__dailyRestoredAt').val()) && (!data.child('transactions/recordSync').exists() || newData.child('transactions/recordSync').val() >= data.child('transactions/recordSync').val()) && (!data.child('ledger/recordSync').exists() || newData.child('ledger/recordSync').val() >= data.child('ledger/recordSync').val())"
      }
    }
  }
}
