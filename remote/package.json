{
  "name": "daily-remote-connector",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build-core.cjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-daily-connector --only database --config emulator.json \"node --test test/emulator/*.test.mjs\"",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "oidc-provider": "9.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "acorn": "8.19.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  }
}
